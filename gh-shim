#!/usr/bin/env bash
# `gh` shim: mints a fresh GitHub App installation token per invocation.
#
# Why this exists. Two facts collide:
#   1. ci/verify-pipeline.sh gates on `gh auth status` (line 571) and then runs
#      `gh pr create` / `gh pr close` for ~40 minutes.
#   2. Installation tokens live 1 hour, and `gh` reads GH_TOKEN once at process
#      start. Exporting a static GH_TOKEN at the top of a long run therefore
#      works right up until it silently doesn't, mid-run, with PRs already open.
#
# Minting per invocation means every `gh` call carries a token with a full
# lifetime ahead of it, so a long run cannot age out from under itself.
#
# This is only reachable when the directory holding this shim sits ahead of
# /usr/bin on PATH. For everyone else the real gh is found first and nothing
# here runs. Scope comes from the caller's GH_APP_REPOS / GH_APP_PERMISSIONS,
# so this shim grants nothing on its own — a caller without the GH_APP_* env
# gets the same "not logged in" it gets today.
#
# History: this used to also require GH_APP_PRIVATE_KEY to be present before
# attempting a mint. That was backwards — gh-app-token.js already does its own
# broker-first, PEM-fallback selection — and it was a latent defect: once the
# credential-unbind sequence removes GH_APP_PRIVATE_KEY from an agent's
# environment, the old condition would skip minting entirely and hand `gh` no
# token at all, while `git push` (the separate credential-helper path) kept
# working. The PEM check was removed 2026-09-07; this file makes that fix
# survive a re-bootstrap instead of living only as a hand-edit on the instance.

set -uo pipefail

REAL_GH=/usr/bin/gh
[ -x "$REAL_GH" ] || { echo "gh-shim: $REAL_GH not found" >&2; exit 127; }

# Companion minter this shim shells out to. Overridable so a checkout or a
# staged copy can point at its own gh-app-token.js instead of an installed one.
APP_TOKEN_JS="${GH_APP_TOKEN_JS:-${PAPERCLIP_HOME:-$HOME/.paperclip}/bin/gh-app-token.js}"

# An explicit token from the caller always wins — never override a credential
# someone deliberately set.
if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  # Failure here is not fatal: fall through unauthenticated and let gh emit its
  # own diagnostic, rather than masking it with one of ours.
  if _tok=$(node "$APP_TOKEN_JS" token 2>/dev/null) && [ -n "$_tok" ]; then
    export GH_TOKEN="$_tok"
  fi
  unset _tok
fi

exec "$REAL_GH" "$@"
