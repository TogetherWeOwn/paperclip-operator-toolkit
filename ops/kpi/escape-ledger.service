[Unit]
Description=Shadow escaped-defect proxies and exact-head review provenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/paperclip-enterprise-company
ExecStart=/usr/bin/python3 -I %h/paperclip-enterprise-company/ops/kpi/escape_ledger.py --root %h/paperclip-enterprise-company --output-dir %h/.local/state/togetherweown/escape-ledger --mirror-root %h/build/review-rules-mirrors --review-db-container paperclip-db --container-runtime docker --memory-dir %h/.claude/projects/-home-ubuntu-paperclip-enterprise-company/memory --entry-point systemd
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
