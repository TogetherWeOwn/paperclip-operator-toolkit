[Unit]
Description=Compute CLIProxy per-account quota-aware weights
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/paperclip/cliproxy-quota-controller.env
Environment=CLIPROXY_QUOTA_SOURCE_REF=@SOURCE_REF@
LoadCredentialEncrypted=cliproxy-management-key:/etc/credstore.encrypted/cliproxy-management-key
ExecStart=/usr/local/libexec/paperclip-cliproxy-quota-controller/@SOURCE_REF@/run-cliproxy-quota-controller.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperclip/cliproxy-quota-controller /var/log/paperclip
