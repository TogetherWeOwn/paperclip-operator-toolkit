# Install as /etc/paperclip/cliproxy-quota-controller.env with owner root:root, mode 0600.
# This file contains nonsecret settings only. Provision the management credential with:
# systemd-creds encrypt - /etc/credstore.encrypted/cliproxy-management-key
# Start in dry-run. Change only CLIPROXY_QUOTA_MODE=apply after reviewing one fresh cycle.
CLIPROXY_QUOTA_MODE=dry-run
CLIPROXY_QUOTA_TELEMETRY=/var/lib/paperclip/cliproxy-quota-controller/telemetry.json
CLIPROXY_MANAGEMENT_URL=http://127.0.0.1:8317
CLIPROXY_QUOTA_DECISION_LOG=/var/log/paperclip/cliproxy-quota-controller.jsonl
CLIPROXY_QUOTA_ROLLBACK_STATE=/var/lib/paperclip/cliproxy-quota-controller/rollback.json
