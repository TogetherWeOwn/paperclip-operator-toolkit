# ===========================================================================
# Caddy site block for the cliproxy-insight read-only lane (TOG-811).
#
# CISO review of 2026-09-03 (TOG-817) approved the containment SHAPE subject to
# five required changes. Every one of them is implemented below and each is
# labelled with the review item number it satisfies. Do not "simplify" a block
# carrying a REQUIRED CHANGE marker without going back to that review.
#
# Substitute before installing:
#   CONTAINER_EGRESS  the Paperclip container's egress address as seen by the
#                     host. Find it with:
#                       podman inspect -f '{{.NetworkSettings.IPAddress}}' <paperclip-container>
#                     On this box the podman network is 10.89.0.0/23.
#
# TWO CREDENTIALS, AND THEY ARE NOT THE SAME SECRET  [REQUIRED CHANGE 2]
# ----------------------------------------------------------------------
#   {$CLIPROXY_INSIGHT_BEARER}  the lane key WE mint (the `cliproxy-usage-lane-key`
#                               secret), sent by the worker as the `x-api-key`
#                               header, not an HTTP Bearer. This is the only
#                               credential that is ever placed in Paperclip's
#                               secret store, and after the TOG-816 recon it is
#                               also the only credential Caddy needs at all. We
#                               rotate and revoke it unilaterally.
#   the REAL CLIProxy management key   does NOT appear in this file and does not
#                               belong in Caddy's environment. It is held by the
#                               host-side sanitizer that this lane proxies to --
#                               see the origin note in block B section 4 for why
#                               the boundary moved. Caddy never forwards it.
#
#   The bearer substitution is mandatory, not one of two options: the review
#   closed that fork explicitly. The recon then made it structural -- there is
#   no CLIProxy route this lane may proxy, so there is nothing for a forwarded
#   management key to authenticate against.
#
#   The bearer reaches Caddy through its environment, and only that way. Put it
#   there with a systemd drop-in reading a 0600 root-owned env file, so the
#   credential exists in exactly one place on this host with exactly one
#   consumer:
#
#     umask 077
#     printf 'CLIPROXY_INSIGHT_BEARER=%s\n' "$paperclip_bearer" \
#       | sudo tee /etc/caddy/cliproxy-insight.env >/dev/null
#     sudo chmod 600 /etc/caddy/cliproxy-insight.env
#     sudo chown root:root /etc/caddy/cliproxy-insight.env
#     sudo systemctl edit caddy      # [Service]
#                                    # EnvironmentFile=/etc/caddy/cliproxy-insight.env
#     sudo systemctl restart caddy   # RESTART, not reload -- a reload does not
#                                    # re-read the unit environment.
#
#   REVOCATION PATH: rotate CLIPROXY_INSIGHT_BEARER in that env file and
#   `systemctl restart caddy`. That kills Paperclip's access without touching
#   the real management key and without involving CLIProxy at all.
#
# MEASURED, NOT ASSUMED (TOG-816 recon, 2026-09-05, CLIProxy v7.2.140)
#   This lane's shape changed after the recon. Do not restore the original
#   draft's `reverse_proxy 127.0.0.1:8317` with a management-key `header_up`:
#   that build exposes NO usage endpoint, and its one counter-bearing route
#   (/v0/management/auth-files) also returns email/account/path/id/project_id
#   and a codex id_token, behind the same key that opens /v0/management/api-keys
#   (inference key in clear) and /v0/management/config. Details in block B.
#
# WHY THIS EXISTS
#   CLIProxy binds host-loopback only (127.0.0.1:8317, TOG-352) and its usage
#   aggregation is in-memory, so it is lost on restart. Paperclip is where the
#   durable history should live -- but the management API that reports usage is
#   the same API that serves /v0/management/auth-files, which returns provider
#   account credentials. A key that can read usage can therefore read every
#   upstream account credential we own.
#
#   This lane exists so the credential Paperclip holds is structurally incapable
#   of reaching auth-files: the read-only path list is enforced HERE, at the
#   edge, not by the plugin's own good behaviour.
# ===========================================================================


# ---------------------------------------------------------------------------
# BLOCK A -- the public CLIProxy vhost.  [REQUIRED CHANGE 3]
#
# Measured live 2026-09-03 by the CISO:
#     GET https://cliproxy.example.net/v0/management/usage
#     -> 401 {"error":"missing management key"}
#
# That is CLIProxy's OWN error, which means the entire raw management surface
# -- including /v0/management/auth-files -- is publicly proxied TODAY, behind
# nothing but the management key. Standing up the narrow lane in block B while
# leaving this open is containment theater: anyone holding the real key still
# reaches auth-files from anywhere on the internet.
#
# So closing this is part of the SAME change, not a follow-up.
#
# If some existing consumer breaks when this lands, that is a finding to report
# on TOG-811 -- not a reason to reopen the route.
# ---------------------------------------------------------------------------
cliproxy.example.net {

	# Management is reachable ONLY through the bearer-terminated lane in
	# block B. All verbs, all subpaths, no exceptions, no bearer check --
	# a 404 here must not depend on who is asking.
	@management path /v0/management /v0/management/*
	respond @management 404

	# ... existing routes for this vhost stay as they are, below this line.
	# This snippet only ADDS the refusal above; it does not describe the rest
	# of the site block. Keep the @management matcher FIRST so nothing later
	# can re-expose the surface.
}


# ---------------------------------------------------------------------------
# BLOCK B -- the insight lane.  [REQUIRED CHANGE 4: dedicated namespace]
#
# A dedicated vhost rather than a path prefix on the shared name. The review
# accepted either; this one is chosen because the allowlist matcher cannot then
# collide with CLIProxy's own route space no matter how that space grows, and
# because block A's blanket 404 and this lane's allowlist never have to be
# reasoned about in the same site block.
#
# The plugin's `baseUrl` config MUST be set to match at enable time:
#     baseUrl = "https://cliproxy-insight.example.net"
# the worker then calls ${baseUrl}/<lane>.json once per enabled lane -- the
# plugin's `laneFiles` (default claude.json, codex.json, kimi.json,
# opencode-go.json, zai.json, antigravity.json). Each of those files is
# allowlisted below. There is NO `/usage-summary` route: v0.3 polls per-lane
# static JSON, one file per lane, not a single summary endpoint.
#
# ORDERING IS THE CONTROL, AND IT IS DELIBERATE  [REQUIRED CHANGE 4]
#   1. unknown path or non-GET verb -> 404   (a scanner learns nothing, and it
#                                             learns it before authenticating)
#   2. wrong source IP               -> 403
#   3. wrong/absent bearer           -> 401, no WWW-Authenticate
#   4. only then: proxy to origin, injecting the real key
#
#   404-before-401 is the point. If the bearer check came first, a scanner with
#   no credential could still map which paths exist by their error codes.
# ---------------------------------------------------------------------------
cliproxy-insight.example.net {

	# --- 1. Path AND method allowlist. --------------------------------------
	# GET is the only verb this lane has. HEAD and OPTIONS are refused too,
	# with the same 404 as an unknown path, so probing cannot distinguish
	# "this path exists but you used the wrong verb" from "no such path".
	#
	# The allowlisted paths are the SANITIZER's per-lane files, not CLIProxy
	# paths. See the origin note in section 4: after the TOG-816 recon there is
	# no CLIProxy management route that may be proxied through this lane at all.
	# Each file is one lane's {schemaVersion, observedAt, records[]} document,
	# and the set here MUST equal the plugin's enabled `laneFiles`.
	#
	# Adding a path here is the ONLY way a new route becomes reachable --
	# there is no wildcard, by design. Adding a lane on the host means adding
	# its file to this list too. Any new path must return sanitized derivative
	# data only; if it can return identity or credential material, it does not
	# go in this list and the finding goes back to the CISO.
	#
	# The two refusals below ARE the allowlist. An earlier draft also defined an
	# `@allowed {method GET; path ...}` matcher here, which no
	# directive ever referenced -- Caddy accepts a defined-but-unused named
	# matcher silently (verified on 2026-09-05 with caddy v2.11.4: `adapt` emits
	# no warning and the matcher is absent from the generated JSON). It was
	# harmless but it read like the control, so a later editor could have
	# "tidied" one of the real refusals below and kept the decorative one.
	# Removed deliberately; do not reintroduce a matcher nothing responds to.
	@notallowed not method GET
	respond @notallowed 404

	# The allowlist is exactly the enabled lane files (the plugin's `laneFiles`).
	# Keep this set in sync with the plugin config: a name the worker polls that
	# is absent here is simply never served -- the worker takes one 404 for it
	# and moves on. The default `laneFiles` are the six below; if you enable
	# `pollAggregates`, also add `/request-rates.json` and `/model-usage-v1.json`.
	@unknownpath not path /claude.json /codex.json /kimi.json /opencode-go.json /zai.json /antigravity.json
	respond @unknownpath 404

	# --- 2. Source restriction.  [REQUIRED CHANGE 1] ------------------------
	# Omitted from the design draft; the review calls this "condition 5 of the
	# approval and it is not optional" in the org-request-mcp snippet this
	# mirrors. Without it, a leaked Paperclip-held bearer is usable from the
	# open internet -- which would make the whole lane worthless the moment
	# the secret store is the thing that leaks.
	#
	# The ONLY legitimate client is the plugin worker inside the Paperclip
	# container on this host.
	#
	# NOTE the ordering, and do NOT add `trusted_proxies` or swap in a
	# `client_ip` matcher: `remote_ip` is the real peer address only because
	# this block trusts no forwarded header. Trusting one makes this control
	# spoofable by an X-Forwarded-For the attacker chooses.
	@notlocal not remote_ip CONTAINER_EGRESS 127.0.0.1
	respond @notlocal 403

	# --- 3. Lane-key termination.  [REQUIRED CHANGE 2] ----------------------
	# The worker sends the Paperclip-minted lane key as the `x-api-key` header
	# (LANE_AUTH_HEADER in src/constants.ts), NOT as an HTTP `Authorization:
	# Bearer` and NOT the management key. This matcher compares that header
	# against the lane key. A copy of this file leaking leaks neither
	# credential: both are `{$...}` expansions resolved from Caddy's environment
	# at config-load time, and this file is the one that tends to get pasted
	# into a ticket. (The env var is still named CLIPROXY_INSIGHT_BEARER for the
	# operator install path; it holds the lane key, sent via x-api-key.)
	@unauthorized not header X-Api-Key "{$CLIPROXY_INSIGHT_BEARER}"
	respond @unauthorized 401 {
		# Deliberately NO WWW-Authenticate. The Paperclip gateway treats a 401
		# carrying a bearer/oauth WWW-Authenticate as a cue to go discover
		# OAuth endpoints on us; we are not an OAuth server, and that
		# discovery would bury the real cause -- a wrong bearer -- under a
		# protocol error.
		close
	}

	# --- 4. Origin.  [REQUIRED CHANGE 2] ------------------------------------
	#
	# THE ORIGIN IS THE SANITIZER, NOT CLIPROXY. This is the single most
	# important line in this file and it is a direct consequence of the
	# TOG-816 operator recon (2026-09-05), which measured CLIProxy v7.2.140
	# and found:
	#
	#   * NO usage endpoint exists in this build. /usage, /usage/statistics,
	#     /usage-statistics, /usage/summary, /quota, /request-statistics and
	#     /logs/summary ALL return 404. The thing this lane was originally
	#     drafted to proxy is not there.
	#   * The only endpoint carrying per-upstream counters is
	#     /v0/management/auth-files -- which also returns `email`, `account`,
	#     `path`, `id`, `auth_index`, `project_id`, and for codex an
	#     `id_token`.
	#   * The SAME management key also opens /v0/management/api-keys (which
	#     returns an inference key in clear) and /v0/management/config.
	#
	# So a path allowlist over CLIProxy's own API cannot achieve containment
	# here: the one useful path is itself identity-bearing. Allowlisting
	# auth-files would hand Paperclip exactly the material this lane exists to
	# withhold. There is no subset of /v0/management/* that is safe to proxy,
	# and this lane therefore proxies NONE of it.
	#
	# The containment boundary moves one hop back: a host-side sanitizer
	# reads auth-files with the management key, strips every identity field,
	# and serves only the derived counters. Caddy's job here is the edge
	# controls -- source IP, method, path, bearer -- in front of that
	# sanitizer. The sanitizer is TOG-975's producer half; the port below is a
	# placeholder until it lands.
	#
	# CLIPROXY_MGMT_KEY is consequently NOT referenced in this block, and no
	# `header_up Authorization` appears here: the real management key belongs
	# to the sanitizer process, not to this proxy hop. Do not add it back.
	# (Keep it out of /etc/caddy/cliproxy-insight.env too -- Caddy has no use
	# for it now; see RUNBOOK step 3.)
	reverse_proxy 127.0.0.1:8318 {
		# Strip anything a client could send that the origin might mistake for
		# an identity or a forwarding claim.
		header_up -X-Forwarded-For-Original
		header_up X-Real-IP {remote_host}

		# The sanitizer is a local process; a slow upstream should surface as
		# a timeout, not an accumulating pile of open sockets. The plugin's
		# own requestTimeoutMs default is 10s, so fail below that.
		transport http {
			dial_timeout 5s
			response_header_timeout 8s
		}
	}

	# --- 5. Logging. --------------------------------------------------------
	# Neither credential may ever reach a log file on a shared host. This lane's
	# logs would otherwise be the one place BOTH secrets could appear in the
	# same record.
	#
	# CORRECTION, measured 2026-09-05 with caddy v2.11.4 (TOG-952). An earlier
	# version of this block claimed "Caddy does not log headers by default and
	# nothing here turns that on." THAT IS FALSE. A bare `log` block emits the
	# full request header map. What actually saves us is a narrower fact: Caddy
	# ships a default redaction for `Authorization` and `Cookie` specifically,
	# which log as the literal string "REDACTED". Verified both halves:
	#
	#   bare `log`  ->  "Authorization":["REDACTED"]      (safe, by default)
	#                   "X-Api-Key":["leakme-12345"]      (LOGGED IN CLEAR)
	#
	# This lane's credential IS `X-Api-Key` -- the worker sends the lane key
	# there (section 3) -- and Caddy does NOT special-case that header: measured
	# above, it logs in clear. So the `X-Api-Key delete` line below is not
	# belt-and-braces, it is THE control. Without it the lane key is written to
	# this log on every request, including the rejected ones: Caddy parses and
	# logs the request header map before the 401/403/404 refusal, so a wrong
	# source or a wrong key does not keep the key out of the log.
	#
	# Authorization and Cookie are deleted too. Caddy default-redacts them, but
	# stating it here makes the file its own guarantee instead of depending on
	# an upstream default that could change, and keeps the lane robust if a
	# client ever sends either. Verified with this exact `format filter` syntax
	# on v2.11.4 -- the named headers are absent from the emitted record, not
	# merely redacted. Verify on the host with a synthetic marker: send
	# `X-Api-Key: LOGPROBE-<nonce>` on both an accepted and a rejected request,
	# then `grep LOGPROBE /var/log/caddy/cliproxy-insight.log` -> no match.
	#
	# NOTE the syntax. `request>headers>Authorization delete` as a direct
	# subdirective of `log` is REJECTED by v2.11.4 ("unrecognized subdirective")
	# -- it must be wrapped in `format filter { wrap json; fields { ... } }` as
	# below. The rejected form appears in older Caddy documentation.
	log {
		output file /var/log/caddy/cliproxy-insight.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Api-Key delete
			}
		}
	}

	# --- 6. Optional: rate limit. -------------------------------------------
	# The review noted (not required) that a Caddy-side rate limit would make
	# the plugin's never-retry-within-a-firing discipline two-layered. The
	# plugin polls once per 10 minutes per company, so any limit above a few
	# requests/minute is invisible to it. Requires the caddy-ratelimit plugin,
	# which is NOT in a stock Caddy build -- left commented rather than
	# shipped, so this file loads on a stock binary.
	#
	# rate_limit {
	#     zone insight {
	#         key    {remote_host}
	#         events 6
	#         window 1m
	#     }
	# }
}
