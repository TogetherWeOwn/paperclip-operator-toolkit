{
  "admission_authorized": false,
  "drain_signal": {
    "allowed": [
      "pool_disabled",
      "max_runners_lowered",
      "min_idle_lowered"
    ],
    "forbidden": [
      "job_cancel",
      "label_change_as_drain",
      "queue_depth_auto",
      "vm_delete_without_signal"
    ],
    "requires": [
      "no_new_admissions_after_signal",
      "recorded_action_ref",
      "reviewed_operator_action"
    ]
  },
  "evidence_class": "synthetic",
  "forbidden_preparation_actions": [
    "active_work_aborted",
    "cache_removal",
    "cap_change",
    "credential_change",
    "pool_change",
    "provider_restart",
    "routing_change",
    "running_vm_profile_change",
    "static_service_change",
    "workflow_edit"
  ],
  "grace": {
    "drain_grace_min": 150,
    "grace_floor_rationale": "proposed only; grace covers the longest eligible job (Offline suites timeout-minutes 150 in this repo's ci.yml); the floor moves if the longest eligible timeout moves",
    "poll_interval_min": 5,
    "poll_rationale": "proposed only; matches the 5m pool-monitor cadence of the pool monitor",
    "runner_bootstrap_timeout_min": 20,
    "bootstrap_rationale": "proposed only; upstream pool default (doc/pools-and-scaling.md); startup bound only, never the drain grace"
  },
  "host_verified": false,
  "installed": false,
  "missing_input_disposition": "HOLD; proposed values are not pins and cannot be used to scale, drain, or delete",
  "reaper": {
    "drained_requires_all": [
      "signal_recorded_before_first_pending_delete",
      "legal_transitions_only",
      "job_completed_naturally_before_deleting",
      "artifacts_complete",
      "vm_absent_and_registration_absent_correlated"
    ],
    "force_transitions": [
      {"from": "running", "to": "pending_force_delete"},
      {"from": "pending_delete", "to": "pending_force_delete"},
      {"from": "pending_force_delete", "to": "deleting"},
      {"from": "error", "to": "deleting"}
    ],
    "graceful_transitions": [
      {"from": "running", "to": "pending_delete"},
      {"from": "pending_delete", "to": "deleting"},
      {"from": "deleting", "to": "deleted"}
    ],
    "orphaned_if_any": [
      "provider_error_or_runner_failed",
      "stopped_or_unknown_terminal",
      "force_delete_inside_grace_or_without_action_ref",
      "deleting_or_deleted_while_job_in_progress",
      "vm_absent_xor_registration_absent"
    ]
  },
  "schema": "garm-drain-contracts.v1",
  "source_baseline": {
    "garm": "0.2.1",
    "lxd": "5.21",
    "provider": "0.1.3",
    "verified_live": false
  },
  "status": "synthetic-proposal-only",
  "timeout_disposition": {
    "force_delete": "separate_reviewed_operator_action_only",
    "new_admissions": "stopped_at_signal",
    "running_job": "continues_to_natural_completion"
  }
}
