#!/bin/bash
# GARM_ISO_BOOTSTRAP_V1
# LXD provider 0.1.3 runner_install_template; pre-baked runner only.
# No service install, agent-mode, dependency install or sudo fallback.
set -euo pipefail
set +x
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "{{ .RunnerUsername }}" = runner ]
[ "$(id -un)" = runner ]
[ "$(id -u)" -gt 0 ]
case "{{ .RunnerName }}" in garm-iso-*) ;; *) exit 1 ;; esac
{{- if .UseJITConfig }}
# JIT path (GARM 0.2.1 default): labels live inside the JIT config, so the
# static template assertion cannot apply. The controller-issued JIT config
# carries the labels instead.
{{- else }}
[ "{{ .RunnerLabels }}" = 'self-hosted,garm-managed' ]
{{- end }}

verify_hardening() {
    [ -f /var/lib/garm-iso/bootstrap.ready ]
    [ ! -L /var/lib/garm-iso/bootstrap.ready ]
    [ "$(stat -c '%u:%g:%a' /var/lib/garm-iso)" = '0:0:755' ]
    [ "$(stat -c '%u:%g:%a' /var/lib/garm-iso/bootstrap.ready)" = '0:0:644' ]
    [ "$(stat -c '%u:%g:%a' /etc/sudoers)" = '0:0:440' ]
    [ "$(id -Gn)" = runner ]
    local expected_script expected_policy actual_script
    { read -r expected_script; read -r expected_policy; } < /var/lib/garm-iso/bootstrap.ready
    actual_script=$(sha256sum /install_runner.sh)
    [ "$expected_script" = "${actual_script%% *}" ]
    [[ "$expected_policy" =~ ^[0-9a-f]{64}$ ]]
    # sudoers remains root-readable (0440). The root hook verifies and records
    # its policy hash; the runner checks its *effective* complete allowlist.
    [ -x /usr/bin/sudo ]
    if sudo -n -l; then return 1; fi
    if sudo -n /usr/bin/true; then return 1; fi
    [ ! -e /var/run/docker.sock ]
    [ ! -e /run/docker.sock ]
    if command -v docker || command -v dockerd; then return 1; fi
}
# Called directly, never in an if/|| context that disables Bash errexit.
verify_hardening

RUN_HOME=/home/runner/actions-runner
cd "$RUN_HOME"
[ "$(./bin/Runner.Listener --version)" = '2.337.0' ]
[ ! -e .runner ]
[ ! -e .credentials ]
# Controller inputs come from the authenticated GARM bootstrap, not a job.
METADATA_URL="{{ .MetadataURL }}"
CALLBACK_URL="{{ .CallbackURL }}"
BEARER_TOKEN="{{ .CallbackToken }}"
[ -n "$METADATA_URL" ]
[ -n "$CALLBACK_URL" ]
[ -n "$BEARER_TOKEN" ]
request() {
    printf 'header = "Authorization: Bearer %s"\n' "$BEARER_TOKEN" |
        curl --config - --fail --silent --show-error --connect-timeout 5 --max-time 30 "$@"
}
{{- if .UseJITConfig }}
# JIT path: the controller serves pre-built credential files over the instance
# metadata, so config.sh is never called.
request "$METADATA_URL/credentials/runner/" > .runner
request "$METADATA_URL/credentials/credentials/" > .credentials
request "$METADATA_URL/credentials/credentials_rsaparams/" > .credentials_rsaparams
# config.sh writes `agentId`; JIT writes `AgentId`. Accept either.
agent_id=$(python3 -c 'import json; d=json.load(open(".runner")); print(int(d.get("AgentId", d.get("agentId"))))')
{{- else }}
ACTIONS_RUNNER_INPUT_TOKEN=$(request "$METADATA_URL/runner-registration-token/")
[ -n "$ACTIONS_RUNNER_INPUT_TOKEN" ]
export ACTIONS_RUNNER_INPUT_TOKEN
verify_hardening
args=(--unattended --url "{{ .RepoURL }}" --name "{{ .RunnerName }}"
      --labels "{{ .RunnerLabels }}" --no-default-labels --ephemeral --disableupdate)
{{- if .GitHubRunnerGroup }}
args+=(--runnergroup "{{ .GitHubRunnerGroup }}")
{{- end }}
./config.sh "${args[@]}"
unset ACTIONS_RUNNER_INPUT_TOKEN
# config.sh must succeed before either idle callback or runner execution.
agent_id=$(python3 -c 'import json; print(int(json.load(open(".runner"))["agentId"]))')
{{- end }}
case "$CALLBACK_URL" in */status|*/status/) ;; *) CALLBACK_URL="$CALLBACK_URL/status" ;; esac
request --request POST --header 'Content-Type: application/json' \
    --data "{\"status\":\"idle\",\"message\":\"isolated bootstrap ready\",\"agent_id\":$agent_id}" \
    "$CALLBACK_URL" >/dev/null
verify_hardening
# Remove bootstrap credentials from disk/env BEFORE a job can execute.
: > /install_runner.sh
unset BEARER_TOKEN METADATA_URL CALLBACK_URL
# Foreground ephemeral runner, as runner. No privileged svc.sh/systemctl path.
exec ./run.sh
