# Never commit operational state or credentials.
*.env
*.pem
*.key
*-log.jsonl
*.jsonl
secure-drop/
*.bak
*.bak-*

# gh-app-token.js writes its minted token here at 0600. The default location is
# $PAPERCLIP_RUN_SCRATCH_DIR, but GH_APP_TOKEN_CACHE can point anywhere, and the
# filename matched none of the patterns above — a LIVE token, one `git add -A`
# from being committed. (TOG-193)
.gh-app-token.json
.gh-app-token.*.json

# Run state the suites drop in the repo root. *.jsonl already covers the queue
# file; these two did not match anything and both survive an interrupted run.
.test-disabled-templates
.provisioner-disabled

# The queue's id-allocation lock (TOG-253) is a DIRECTORY named "<queue>.lock".
# `*.jsonl` does NOT cover it: that pattern matches on the suffix, and this name
# ends in .lock. The lock deliberately survives a killed writer — the next
# writer clears it after a pid liveness check — which is precisely the window in
# which somebody runs `git add -A`. Verified with `git check-ignore`.
*.jsonl.lock
*.jsonl.lock/

# Per-operator agent-harness config. Not a secret, but it is local machine state
# and pins absolute paths that mean nothing on anyone else's checkout.
.claude/

# Installed dependencies for plugins/gh-token-broker. package-lock.json IS
# tracked, so CI installs are reproducible without vendoring the tree. In the
# agent workspace this path is a SYMLINK to the instance plugin root
# (/paperclip/.paperclip/plugins/node_modules) — committing it would either
# commit a dangling absolute symlink or splat the whole instance tree in here.
#   BOTH forms are listed deliberately. A trailing slash matches DIRECTORIES
# ONLY, and git records a symlink as a file, so `node_modules/` alone does not
# ignore the workspace symlink — the exact case the paragraph above is about.
# Verified with `git check-ignore`: with only the slashed form, `ln -s …
# node_modules` shows up as an untracked `?? node_modules` ready to commit.
node_modules
node_modules/

# omniroute-broker's dist/ is hand-written source and is the plugin entrypoint,
# not generated output. Keep this explicit so a future blanket dist/ rule cannot
# silently make the authoritative broker disappear from a fresh clone or CI.
!plugins/omniroute-broker/dist/
!plugins/omniroute-broker/dist/*.js
